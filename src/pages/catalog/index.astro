---
import { createCompositionRoot } from '@app/composition-root';
import CatalogFilters from '@presentation/components/catalog/CatalogFilters.astro';
import CatalogGrid from '@presentation/components/catalog/CatalogGrid.astro';
import EmptyState from '@presentation/components/shared/EmptyState.astro';
import ResponsiveContainer from '@presentation/components/shared/ResponsiveContainer.astro';
import BaseLayout from '@presentation/layouts/BaseLayout.astro';

const model = await createCompositionRoot().getCatalogPage.execute();
---

<BaseLayout {model} page="catalog">
  <section class="section" data-page-experience data-experience="catalog-index" data-catalog-index>
    <ResponsiveContainer>
      <header class="section-heading">
        <p class="eyebrow">Catalogo completo / {model.resultCount} articoli</p>
        <h1 data-animate="page-title">Quattro mondi,<br />un solo catalogo.</h1>
        <p class="lead">
          Esplora i quattro articoli attraverso i rispettivi cubi. Ricerca, filtri e ordinamento
          lavorano esclusivamente su questa selezione.
        </p>
      </header>

      <CatalogFilters {model} />
      <div class="catalog-status" aria-live="polite">
        <p><strong data-catalog-result-count>{model.resultCount}</strong> risultati</p>
        <p>Quattro articoli · contenuti aggiornabili via MDX</p>
      </div>

      <CatalogGrid items={model.items} loaderCritical />
      <div data-catalog-no-results hidden>
        <EmptyState
          title="Nessun articolo corrisponde"
          description="Prova a cambiare ricerca o filtri. Il catalogo completo resta disponibile."
        />
      </div>
    </ResponsiveContainer>
  </section>
</BaseLayout>
