---
import { createCompositionRoot } from '@app/composition-root';
import HobbyGrid from '@presentation/components/profile/HobbyGrid.astro';
import ProfileIntro from '@presentation/components/profile/ProfileIntro.astro';
import ResumeTimeline from '@presentation/components/profile/ResumeTimeline.astro';
import Section from '@presentation/components/shared/Section.astro';
import BaseLayout from '@presentation/layouts/BaseLayout.astro';

const model = await createCompositionRoot().getAboutPage.execute();
---

<BaseLayout {model} page="about" experience="profile-editorial">
  <Section>
    <ProfileIntro {model} />
  </Section>
  <Section eyebrow="Curriculum" title="Esperienze">
    <ResumeTimeline items={model.workExperience} />
  </Section>
  <Section eyebrow="Formazione" title="Studi">
    <ResumeTimeline items={model.education} />
  </Section>
  <Section eyebrow="Strumenti" title="Competenze">
    <ul class="category-list">
      {
        model.skills.map((skill, index) => (
          <li>
            <a href={'/catalog/?query=' + encodeURIComponent(skill.name)}>
              <span class="eyebrow">0{index + 1}</span>
              <span>
                <>
                  <strong>{skill.name}</strong>
                  <br />
                  <span class="muted">{skill.level}</span>
                </>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
  <Section eyebrow="Fuori dallo schermo" title="Hobby">
    <HobbyGrid hobbies={model.hobbies} />
  </Section>
</BaseLayout>
