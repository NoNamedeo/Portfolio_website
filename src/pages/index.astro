---
import Button from '@presentation/components/shared/Button.astro';
import EntryLayout from '@presentation/layouts/EntryLayout.astro';
---

<EntryLayout
  title="Studio Prisma"
  description="Scegli quale versione del portfolio visitare."
  canonicalPath="/"
>
  <main class="entry-page">
    <section class="entry-page__content" aria-labelledby="entry-title">
      <p class="eyebrow">Studio Prisma</p>
      <h1 id="entry-title">Scegli una pagina</h1>
      <div class="entry-page__actions">
        <Button href="/portfolio/">Home attuale</Button>
        <Button href="/prova/" variant="secondary">Pagina di prova</Button>
        <Button href="/canals/" variant="secondary">Canals</Button>
      </div>
    </section>
  </main>
</EntryLayout>

<style>
  .entry-page {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: var(--gutter);
  }

  .entry-page__content {
    display: grid;
    gap: var(--space-l);
    justify-items: center;
    text-align: center;
  }

  .entry-page__content h1 {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
  }

  .entry-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: center;
  }

  @media (max-width: 30rem) {
    .entry-page__actions {
      width: min(100%, 18rem);
    }

    .entry-page__actions :global(.button) {
      width: 100%;
    }
  }
</style>
