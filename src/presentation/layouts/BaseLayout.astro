---
import type { SiteShellModel } from '@application/models/page-models';
import SiteFooter from '@presentation/components/navigation/SiteFooter.astro';
import SiteHeader from '@presentation/components/navigation/SiteHeader.astro';
import LoadingScreen from '@presentation/components/shared/LoadingScreen.astro';
import SeoHead from '@presentation/components/shared/SeoHead.astro';
import '@styles/global.css';

interface Props {
  model: SiteShellModel;
  page: string;
  theme?: string;
  experience?: string;
  transition?: string;
}

const {
  model,
  page,
  theme = 'store-neutral',
  experience = 'none',
  transition = 'none'
} = Astro.props;
const lang = model.locale.split('-')[0] ?? 'it';
const criticalAssets =
  page === 'home'
    ? [
        '/3D_models/glass_plate_web.glb',
        '/3D_models/competenze_in_vetrina.glb',
        '/3D_models/idee_in_movimento.glb',
        '/3D_models/glass_cubes_collection_1.glb',
        '/3D_models/glass_cubes_design_plasma.glb'
      ]
    : page === 'catalog' || page === 'catalog-item'
      ? ['/3D_models/glass_cubes_design_plasma.glb']
      : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#06070a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {
      criticalAssets.map((asset) => (
        <link rel="preload" href={asset} as="fetch" crossorigin="anonymous" />
      ))
    }
    <SeoHead seo={model.seo} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.siteLoaderStarted = String(performance.now());
        root.dataset.siteLoaderState = 'pending';
      })();
    </script>
  </head>
  <body
    data-page={page}
    data-theme={theme}
    data-experience={experience}
    data-transition={transition}
  >
    <LoadingScreen />
    <a class="skip-link" href="#main-content">Vai al contenuto</a>
    <SiteHeader siteName={model.name} currentPath={Astro.url.pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter siteName={model.name} tagline={model.tagline} />
    <p class="sr-only" data-app-announcer aria-live="polite" aria-atomic="true"></p>
    <script>
      import '@presentation/client/main';
    </script>
  </body>
</html>
