---
interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
---

<div
  class="site-loader"
  data-site-loader
  role="status"
  aria-live="polite"
  aria-label="Caricamento del sito"
>
  <div class="site-loader__topline" aria-hidden="true">
    <span>{siteName}</span>
    <span>Edizione digitale · 01</span>
  </div>

  <div class="site-loader__window">
    <div class="site-loader__visual" aria-hidden="true">
      <span class="site-loader__pane site-loader__pane--one"></span>
      <span class="site-loader__pane site-loader__pane--two"></span>
      <span class="site-loader__pane site-loader__pane--three"></span>
    </div>

    <div class="site-loader__copy">
      <p class="site-loader__eyebrow">Preparazione portfolio</p>
      <p class="site-loader__title">Mettiamo tutto<br />in vetrina.</p>
      <p class="site-loader__message">Le esperienze stanno prendendo posto.</p>
    </div>

    <div class="site-loader__progress" aria-hidden="true">
      <span class="site-loader__progress-bar"></span>
    </div>
  </div>

  <div class="site-loader__footer" aria-hidden="true">
    <span>Caricamento esperienza</span>
    <span class="site-loader__pulse"></span>
  </div>
</div>

<script is:inline>
  (() => {
    const LOADER_READY_EVENT = 'portfolio:app-ready';
    const LOADER_STORAGE_KEY = 'portfolio-store:loader-seen';
    const LOADER_MINIMUM_DURATION = 1100;
    const LOADER_MAXIMUM_WAIT = 7000;
    const LOADER_EXIT_DURATION = 520;

    const root = document.documentElement;
    const loader = document.querySelector('[data-site-loader][role="status"]');

    if (!loader || root.dataset.siteLoaderState !== 'pending') {
      loader?.remove();
      return;
    }

    document.body.setAttribute('aria-busy', 'true');
    const startedAt = Number(root.dataset.siteLoaderStarted ?? performance.now());

    const waitForWindow = new Promise((resolve) => {
      if (document.readyState === 'complete') {
        resolve();
        return;
      }
      window.addEventListener('load', () => resolve(), { once: true });
    });

    const waitForApp = new Promise((resolve) => {
      if (root.dataset.portfolioApp === 'ready') {
        resolve();
        return;
      }
      window.addEventListener(LOADER_READY_EVENT, () => resolve(), { once: true });
    });

    const maximumWait = new Promise((resolve) => {
      window.setTimeout(resolve, LOADER_MAXIMUM_WAIT);
    });

    const dismissLoader = async () => {
      await Promise.race([Promise.all([waitForWindow, waitForApp]), maximumWait]);

      const remainingMinimum = Math.max(
        0,
        LOADER_MINIMUM_DURATION - (performance.now() - startedAt)
      );
      if (remainingMinimum > 0) {
        await new Promise((resolve) => window.setTimeout(resolve, remainingMinimum));
      }

      root.dataset.siteLoaderState = 'leaving';
      loader.setAttribute('aria-hidden', 'true');
      document.body.removeAttribute('aria-busy');

      try {
        window.sessionStorage.setItem(LOADER_STORAGE_KEY, 'true');
      } catch {
        // Lo storage può non essere disponibile: il loader resta comunque non bloccante.
      }

      window.setTimeout(() => {
        loader.remove();
        delete root.dataset.siteLoaderState;
        delete root.dataset.siteLoaderStarted;
      }, LOADER_EXIT_DURATION);
    };

    void dismissLoader();
  })();
</script>

<style>
  .site-loader {
    position: fixed;
    z-index: calc(var(--z-overlay) + 100);
    inset: 0;
    display: none;
    grid-template-rows: auto 1fr auto;
    min-width: 20rem;
    min-height: 100svh;
    padding: clamp(1rem, 2.6vw, 2.5rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 12%, rgb(255 90 61 / 22%), transparent 24rem),
      radial-gradient(circle at 86% 78%, rgb(74 105 226 / 13%), transparent 28rem), #11120f;
    color: #f7f4e9;
    opacity: 1;
    transition:
      opacity 420ms var(--ease-out),
      visibility 420ms var(--ease-out);
  }

  :global(html[data-site-loader-state='pending']) {
    overflow: hidden;
  }

  :global(html[data-site-loader-state='pending']) .site-loader,
  :global(html[data-site-loader-state='leaving']) .site-loader {
    display: grid;
  }

  :global(html[data-site-loader-state='leaving']) .site-loader {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .site-loader__topline,
  .site-loader__footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--step--1);
    font-weight: 720;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-loader__topline {
    padding-block-end: var(--space-m);
    border-bottom: 1px solid rgb(255 255 255 / 18%);
  }

  .site-loader__window {
    position: relative;
    display: grid;
    width: min(100%, 68rem);
    min-height: min(64svh, 39rem);
    align-self: center;
    justify-self: center;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 19%);
    border-radius: var(--radius-l);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 8%), transparent 48%), rgb(255 255 255 / 2%);
    box-shadow:
      0 2.5rem 7rem rgb(0 0 0 / 35%),
      inset 0 1px rgb(255 255 255 / 9%);
    isolation: isolate;
  }

  .site-loader__visual {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .site-loader__visual::before {
    position: absolute;
    width: 30rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 90 61 / 16%);
    filter: blur(70px);
    content: '';
    inset: 12% auto auto 44%;
  }

  .site-loader__pane {
    position: absolute;
    display: block;
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: clamp(0.8rem, 1.5vw, 1.4rem);
    background: linear-gradient(135deg, rgb(255 255 255 / 16%), rgb(255 255 255 / 2%));
    box-shadow:
      inset 0 1px rgb(255 255 255 / 22%),
      0 1.5rem 3rem rgb(0 0 0 / 17%);
    backdrop-filter: blur(12px);
    animation: loader-drift 3.4s ease-in-out infinite alternate;
  }

  .site-loader__pane--one {
    top: 8%;
    right: 5%;
    width: 34%;
    height: 41%;
    rotate: 4deg;
  }

  .site-loader__pane--two {
    right: 21%;
    bottom: 8%;
    width: 42%;
    height: 35%;
    rotate: -5deg;
    animation-delay: -1.3s;
  }

  .site-loader__pane--three {
    top: 24%;
    left: 8%;
    width: 28%;
    height: 26%;
    rotate: 7deg;
    animation-delay: -2.1s;
  }

  .site-loader__copy {
    align-self: center;
    padding: clamp(1.5rem, 5vw, 5rem);
  }

  .site-loader__eyebrow {
    margin-block-end: var(--space-s);
    color: #ff8a71;
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-loader__title {
    max-width: 9ch;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 8.5vw, 8rem);
    font-weight: 780;
    letter-spacing: -0.075em;
    line-height: 0.84;
    text-transform: uppercase;
  }

  .site-loader__message {
    max-width: 28rem;
    margin-block-start: var(--space-l);
    color: rgb(247 244 233 / 68%);
    font-size: var(--step-0);
  }

  .site-loader__progress {
    position: absolute;
    right: clamp(1.5rem, 4vw, 3.5rem);
    bottom: clamp(1.5rem, 4vw, 3.5rem);
    left: clamp(1.5rem, 4vw, 3.5rem);
    height: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 18%);
  }

  .site-loader__progress-bar {
    display: block;
    width: 42%;
    height: 100%;
    background: var(--color-accent);
    box-shadow: 0 0 1.2rem rgb(255 90 61 / 68%);
    animation: loader-progress 1.15s var(--ease-out) infinite;
  }

  .site-loader__footer {
    justify-content: flex-end;
    gap: 0.75rem;
    padding-block-start: var(--space-m);
    color: rgb(247 244 233 / 62%);
  }

  .site-loader__pulse {
    width: 0.55rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 0 rgb(255 90 61 / 52%);
    animation: loader-pulse 1.4s ease-out infinite;
  }

  @keyframes loader-progress {
    from {
      transform: translateX(-115%);
    }

    to {
      transform: translateX(340%);
    }
  }

  @keyframes loader-drift {
    from {
      translate: 0 -0.35rem;
    }

    to {
      translate: 0 0.45rem;
    }
  }

  @keyframes loader-pulse {
    70% {
      box-shadow: 0 0 0 0.6rem rgb(255 90 61 / 0%);
    }

    100% {
      box-shadow: 0 0 0 0 rgb(255 90 61 / 0%);
    }
  }

  @media (max-width: 46rem) {
    .site-loader__topline span:last-child {
      display: none;
    }

    .site-loader__window {
      min-height: min(68svh, 38rem);
    }

    .site-loader__copy {
      align-self: start;
      padding-block-start: clamp(3.5rem, 14vw, 6rem);
    }

    .site-loader__title {
      font-size: clamp(3.1rem, 16vw, 5.2rem);
    }

    .site-loader__pane--one {
      top: 48%;
      width: 48%;
      height: 29%;
    }

    .site-loader__pane--two {
      right: 22%;
      bottom: 7%;
      width: 55%;
      height: 24%;
    }

    .site-loader__pane--three {
      top: 55%;
      left: 3%;
      width: 38%;
      height: 19%;
    }

    .site-loader__message {
      max-width: 20rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-loader,
    .site-loader__pane,
    .site-loader__progress-bar,
    .site-loader__pulse {
      animation: none;
      transition-duration: 0.01ms;
    }

    .site-loader__progress-bar {
      width: 72%;
    }
  }
</style>
