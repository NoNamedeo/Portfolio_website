<div
  class="site-loader"
  data-site-loader
  role="status"
  aria-live="polite"
  aria-label="Caricamento del sito"
>
  <span class="site-loader__indicator" aria-hidden="true"></span>
</div>

<script is:inline>
  (() => {
    const LOADER_READY_EVENT = 'portfolio:app-ready';
    const LOADER_MINIMUM_DURATION = 420;
    const LOADER_MAXIMUM_WAIT = 30000;
    const LOADER_EXIT_DURATION = 260;

    const root = document.documentElement;
    const loader = document.querySelector('[data-site-loader][role="status"]');

    if (!loader || root.dataset.siteLoaderState !== 'pending') {
      loader?.remove();
      return;
    }

    document.body.setAttribute('aria-busy', 'true');
    const startedAt = Number(root.dataset.siteLoaderStarted ?? performance.now());
    const waitForApp = new Promise((resolve) => {
      if (root.dataset.portfolioApp === 'ready') {
        resolve();
        return;
      }
      window.addEventListener(LOADER_READY_EVENT, () => resolve(), { once: true });
    });
    const maximumWait = new Promise((resolve) => {
      window.setTimeout(resolve, LOADER_MAXIMUM_WAIT);
    });

    const dismissLoader = async () => {
      await Promise.race([waitForApp, maximumWait]);
      const remainingMinimum = Math.max(
        0,
        LOADER_MINIMUM_DURATION - (performance.now() - startedAt)
      );
      if (remainingMinimum > 0) {
        await new Promise((resolve) => window.setTimeout(resolve, remainingMinimum));
      }

      root.dataset.siteLoaderState = 'leaving';
      loader.setAttribute('aria-hidden', 'true');
      document.body.removeAttribute('aria-busy');

      window.setTimeout(() => {
        loader.remove();
        delete root.dataset.siteLoaderState;
        delete root.dataset.siteLoaderStarted;
      }, LOADER_EXIT_DURATION);
    };

    void dismissLoader();
  })();
</script>

<style>
  .site-loader {
    position: fixed;
    z-index: calc(var(--z-overlay) + 100);
    inset: 0;
    display: none;
    min-width: 20rem;
    min-height: 100svh;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, rgb(130 217 255 / 5%), transparent 20rem), #06070a;
    color: var(--color-ink);
    opacity: 1;
    transition:
      opacity 220ms var(--ease-out),
      visibility 220ms var(--ease-out);
  }

  :global(html[data-site-loader-state='pending']) {
    overflow: hidden;
  }

  :global(html[data-site-loader-state='pending']) .site-loader,
  :global(html[data-site-loader-state='leaving']) .site-loader {
    display: grid;
  }

  :global(html[data-site-loader-state='leaving']) .site-loader {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .site-loader__indicator {
    position: relative;
    width: 2.15rem;
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: 0.5rem;
    box-shadow:
      inset 0 1px rgb(255 255 255 / 8%),
      0 0 2.5rem rgb(130 217 255 / 8%);
    animation: loader-turn 1.3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .site-loader__indicator::after {
    position: absolute;
    inset: 0.42rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 1.25rem rgb(130 217 255 / 48%);
    content: '';
    animation: loader-breathe 1.3s ease-in-out infinite;
  }

  @keyframes loader-turn {
    50% {
      border-radius: 50%;
      transform: rotate(180deg) scale(0.9);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes loader-breathe {
    50% {
      opacity: 0.45;
      transform: scale(0.68);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-loader,
    .site-loader__indicator,
    .site-loader__indicator::after {
      animation: none;
      transition-duration: 0.01ms;
    }
  }
</style>
