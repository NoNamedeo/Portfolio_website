---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a
  class:list={['experimental-mark', className]}
  href="/prova/"
  aria-label="Alejandro Innocenzi, home"
>
  <img
    class="experimental-mark__image"
    src="/media/prova/alejandro-mark.jfif"
    alt=""
    width="240"
    height="240"
  />
  <span class="experimental-mark__label">Alejandro Innocenzi</span>
</a>
