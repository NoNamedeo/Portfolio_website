---
import ExperimentalMark from './ExperimentalMark.astro';
---

<footer class="experimental-footer" data-header-tone="light">
  <div class="experimental-footer__top">
    <p class="experimental-kicker">Alejandro Innocenzi</p>
    <div>
      <a href="/prova/progetto/laurea-fisica/" data-transition-link>Fisica</a>
      <span aria-hidden="true">|</span>
      <a href="/prova/progetto/laurea-informatica/" data-transition-link>Informatica</a>
      <span aria-hidden="true">|</span>
      <a href="/prova/progetto/sef-framework/" data-transition-link>SEF</a>
    </div>
  </div>

  <a class="experimental-footer__word" href="/prova/contatti/" data-transition-link> INNOCENZI </a>

  <div class="experimental-footer__bottom">
    <p>PORTFOLIO PERSONALE ©2026</p>
    <nav aria-label="Informazioni legali">
      <a href="/prova/privacy/" data-transition-link>Privacy</a>
      <a href="/prova/cookie/" data-transition-link>Cookie</a>
      <a href="/prova/note-legali/" data-transition-link>Note legali</a>
