---
import Button from '@presentation/components/shared/Button.astro';
import ResponsiveContainer from '@presentation/components/shared/ResponsiveContainer.astro';
---

<section
  class="glass-concept"
  aria-labelledby="glass-concept-title"
  data-page-experience
  data-experience="glass-cube-concept"
  data-glass-cube-concept-root
>
  <ResponsiveContainer>
    <div class="glass-concept__layout">
      <div class="glass-concept__copy">
        <p class="eyebrow">Il concetto</p>
        <h2 id="glass-concept-title">Un acquisto che apre una conversazione</h2>
        <p class="lead">
          Qui il linguaggio dell’e-commerce rende esplorabile un percorso professionale. Il checkout
          raccoglie una richiesta: nessun pagamento viene elaborato.
        </p>
        <div class="cluster">
          <Button href="/catalog/">Sfoglia i quattro articoli</Button>
        </div>
      </div>

      <div class="glass-concept__scene">
        <div class="glass-concept__viewport" data-glass-cube-stage aria-hidden="true">
          <canvas class="glass-concept__canvas" data-glass-cube-canvas></canvas>
          <div class="glass-cube-fallback">
            <span class="glass-cube-fallback__body"></span>
          </div>
          <p class="glass-concept__scene-caption">Un solo cubo. Una rotazione discreta.</p>
        </div>
      </div>
    </div>
  </ResponsiveContainer>
</section>
