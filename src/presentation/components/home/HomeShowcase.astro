---
import Button from '@presentation/components/shared/Button.astro';
import ResponsiveContainer from '@presentation/components/shared/ResponsiveContainer.astro';

interface Props {
  title: string;
  accent: string;
  description: string;
}

const { title, accent, description } = Astro.props;
---

<section
  class="home-showcase"
  aria-labelledby="home-showcase-title"
  data-page-experience
  data-experience="home-showcase"
  data-showcase-root
>
  <ResponsiveContainer>
    <header class="home-showcase__header">
      <p class="eyebrow">Portfolio commerce · Edizione 01</p>
      <p class="home-showcase__edition" aria-hidden="true">01 / Showcase</p>
    </header>
  </ResponsiveContainer>

  <div class="home-showcase__scroll-scene" data-showcase-scroll-scene>
    <div class="home-showcase__stage" data-showcase-stage>
      <div class="home-showcase__ambience" aria-hidden="true"></div>

      <h1 id="home-showcase-title" class="sr-only">{title}. {accent}.</h1>

      <div class="home-showcase__glass" data-showcase-glass aria-hidden="true">
        <canvas
          class="home-showcase__glass-canvas"
          data-showcase-glass-canvas
          data-glass-model="/3D_models/glass_plate_web.glb"
          data-back-slogan-model="/3D_models/competenze_in_vetrina.glb"
          data-front-slogan-model="/3D_models/idee_in_movimento.glb"
          aria-hidden="true"></canvas>
        <div class="home-showcase__glass-fallback" data-showcase-glass-fallback>
          <span class="home-showcase__fallback-orbit"></span>
          <span class="home-showcase__fallback-glow"></span>
          <span class="home-showcase__fallback-slogan home-showcase__fallback-slogan--back">
            {title}
          </span>
          <span class="home-showcase__fallback-slogan home-showcase__fallback-slogan--front">
            {accent}
          </span>
        </div>
      </div>
    </div>
  </div>

  <ResponsiveContainer>
    <footer class="home-showcase__footer">
      <p class="lead">{description}</p>
      <Button href="/catalog/">Esplora il catalogo <span aria-hidden="true">↗</span></Button>
    </footer>
  </ResponsiveContainer>
</section>
