---
import type { AboutPageModel } from '@application/models/page-models';

interface Props {
  model: AboutPageModel;
}

const { model } = Astro.props;
---

<div class="profile-intro">
  <div class="flow">
    <p class="eyebrow">Profilo / CV / Persona</p>
    <h1 data-animate="profile-name">{model.fullName}</h1>
  </div>
  <div class="flow">
    <p class="lead">{model.headline}</p>
    <p>{model.biography}</p>
    <p>
      <a href={'mailto:' + model.contact.email}>{model.contact.email}</a><br />
      <span class="muted">{model.contact.location}</span>
    </p>
    <ul class="tags" aria-label="Profili sociali">
      {
        model.socialLinks.map((link) => (
          <li>
            <a class="tag" href={link.href} rel="me">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
