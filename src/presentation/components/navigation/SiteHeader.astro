---
import CartIndicator from '@presentation/components/cart/CartIndicator.astro';
import MainNavigation from './MainNavigation.astro';
import ResponsiveContainer from '@presentation/components/shared/ResponsiveContainer.astro';

interface Props {
  siteName: string;
  currentPath: string;
}

const { siteName, currentPath } = Astro.props;
---

<header class="site-header">
  <ResponsiveContainer class="site-header__inner">
    <a class="brand" href="/" aria-label={siteName + ', homepage'}>{siteName}</a>
    <MainNavigation {currentPath} />
    <CartIndicator />
  </ResponsiveContainer>
</header>
