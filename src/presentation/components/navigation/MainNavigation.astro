---
import { messages } from '@app/config/messages';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const items = [
  { href: '/portfolio/', label: messages.navigation.home },
  { href: '/catalog/', label: messages.navigation.catalog }
];

const isCurrent = (href: string): boolean => currentPath.startsWith(href);
---

<nav class="main-navigation" aria-label="Navigazione principale">
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
