---
import { getEntry, render } from 'astro:content';

interface Props {
  contentId: string;
}

const { contentId } = Astro.props;
const entry = await getEntry('catalog', contentId);
if (!entry) throw new Error('Contenuto catalogo non trovato: ' + contentId);
const { Content } = await render(entry);
---

<div class="prose">
  <Content />
</div>
