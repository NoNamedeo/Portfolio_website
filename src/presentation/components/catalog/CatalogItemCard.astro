---
import type { CatalogItemCardModel } from '@application/models/page-models';
import AcquisitionButton from './AcquisitionButton.astro';
import PricingLabel from './PricingLabel.astro';

interface Props {
  item: CatalogItemCardModel;
  priority?: boolean;
}

const { item, priority = false } = Astro.props;
---

<article
  class="catalog-card"
  data-catalog-item={item.id}
  data-search={item.searchText}
  data-type={item.type}
  data-categories={item.categories.join('|').toLocaleLowerCase('it')}
  data-year={item.year}
  data-order={item.order}
  data-featured={item.featured ? '1' : '0'}
  data-theme={item.themeKey}
  data-experience={item.experienceKey}
>
  <a
    class="catalog-card__media"
    href={'/catalog/' + item.slug + '/'}
    tabindex="-1"
    aria-hidden="true"
  >
    <img
      src={item.media.src}
      alt={item.media.alt}
      width={item.media.width}
      height={item.media.height}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
    {item.featured && <span class="catalog-card__badge">In evidenza</span>}
  </a>
  <div class="catalog-card__body">
    <div class="catalog-card__topline">
      <p class="eyebrow">{item.typeLabel} · {item.year}</p>
      <PricingLabel label={item.pricingLabel} />
    </div>
    <h3 class="catalog-card__title">
      <a href={'/catalog/' + item.slug + '/'}>{item.title}</a>
    </h3>
    <p class="catalog-card__description">{item.shortDescription}</p>
    <ul class="tags" aria-label="Categorie">
      {item.categories.map((category) => <li class="tag">{category}</li>)}
    </ul>
    <div class="catalog-card__footer">
      <span class="muted">{item.availabilityLabel}</span>
      <AcquisitionButton {item} />
    </div>
  </div>
</article>
