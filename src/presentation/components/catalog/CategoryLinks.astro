---
interface Props {
  categories: readonly { readonly name: string; readonly count: number }[];
}

const { categories } = Astro.props;
---

<section
  class="catalog-categories"
  aria-labelledby="catalog-categories-title"
  data-catalog-categories
>
  <header class="section-heading">
    <p class="eyebrow">Sezioni</p>
    <h2 id="catalog-categories-title">Esplora per categoria</h2>
  </header>
  <ul class="category-list">
    {
      categories.map((category, index) => (
        <li>
          <a
            href={'/catalog/?category=' + encodeURIComponent(category.name.toLocaleLowerCase('it'))}
          >
            <span class="eyebrow">{String(index + 1).padStart(2, '0')}</span>
            <span>
              <strong>{category.name}</strong>
              <br />
              <span class="muted">
                {category.count} {category.count === 1 ? 'articolo' : 'articoli'}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
