---
import type { CatalogItemCardModel } from '@application/models/page-models';

interface Props {
  item: CatalogItemCardModel;
  visualIndex: number;
  accent: string;
  decorative?: boolean;
}

const { item, visualIndex, accent, decorative = false } = Astro.props;
---

<a
  class="moving-catalog-card"
  href={'/catalog/' + item.slug + '/'}
  tabindex={decorative ? -1 : undefined}
  data-marquee-item-link
  data-cube-card
  data-cube-index={visualIndex}
  style={`--cube-accent: ${accent}`}
>
  <span
    class="moving-catalog-card__cube-stage"
    data-cube-slot
    data-cube-accent={accent}
    data-cube-variant={visualIndex}
    aria-hidden="true"
  >
    <span class="moving-catalog-card__cube-fallback">
      <span class="moving-catalog-card__cube-core"></span>
    </span>
  </span>
  <span class="moving-catalog-card__body">
    <span class="moving-catalog-card__title">{item.title}</span>
    <span class="sr-only">{item.typeLabel}, {item.year}. {item.pricingLabel}</span>
  </span>
</a>
